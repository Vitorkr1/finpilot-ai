# MongoDB Atlas (cluster M0 free)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/criaos

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Cloudinary (free tier) — upload de fotos de OS, assinaturas, documentos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq API (free tier) — assistente de IA e triagem WhatsApp
GROQ_API_KEY=
# Opcional — só mude se o assistente de IA passar a responder 502 "falha ao
# falar com o provedor de IA". Os modelos Llama saíram do plano padrão de
# desenvolvedor da Groq (agora exigem contato comercial) — confira o catálogo
# atual com preço aberto em console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-20b

# Super admin inicial (criado apenas via seed script, nunca por formulário público)
SUPER_ADMIN_EMAIL=admin@criatech.online
SUPER_ADMIN_PASSWORD=change-me

# Opcional: só necessário se você não tiver shell no host (ex. Render free) para
# rodar `npm run seed:super-admin`. Define um token de uso único que ativa
# POST /api/setup/bootstrap-super-admin (ver README). Sem SETUP_TOKEN, essa
# rota não existe (404). Remova esta variável depois do primeiro uso.
SETUP_TOKEN=

# Servidor
PORT=5000
CLIENT_URL=http://localhost:5173

# Defina como 1 quando estiver atrás de um proxy reverso confiável (Render,
# Railway, etc.) — necessário para req.ip e o express-rate-limit lerem o IP
# real do cliente via X-Forwarded-For. Deixe em branco em dev local.
TRUST_PROXY=
