<%- include('partials/head') %>

<style>
  :root {
    --ct-bg: #0a0e1a;
    --ct-bg-soft: #0f1424;
    --ct-blue: #2563eb;
    --ct-blue-light: #3b82f6;
    --ct-purple: #7c3aed;
    --ct-green: #22c55e;
    --ct-danger: #ef4444;
    --ct-text-muted: #94a3b8;
    --ct-border: rgba(148, 163, 184, 0.12);
  }

  .fp-fade {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .fp-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .fp-gradient-text {
    background: linear-gradient(90deg, var(--ct-blue-light), var(--ct-purple));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Selo / faixa de crédito CriaTech */
  .fp-cria-strip {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    max-width: 640px;
    margin: 0 auto;
    padding: 1.1rem 1.4rem;
    border-radius: 16px;
    border: 1px solid var(--ct-border);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(124, 58, 237, 0.08));
    text-align: left;
    text-decoration: none;
    transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .fp-cria-strip:hover {
    border-color: rgba(124, 58, 237, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 16px 32px -18px rgba(37, 99, 235, 0.4);
  }
  .fp-cria-mark {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
    background: linear-gradient(135deg, var(--ct-blue-light), var(--ct-purple));
  }
  .fp-cria-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .fp-cria-body {
    flex: 1;
    min-width: 0;
  }
  .fp-cria-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ct-text-muted);
    margin-bottom: 2px;
  }
  .fp-cria-name {
    font-weight: 700;
    font-size: 1rem;
    background: linear-gradient(90deg, var(--ct-blue-light), var(--ct-purple));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fp-cria-desc {
    display: block;
    font-size: 0.82rem;
    color: var(--ct-text-muted);
    margin-top: 3px;
    line-height: 1.4;
  }
  .fp-cria-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ct-blue-light);
    white-space: nowrap;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--ct-border);
    transition: background .2s ease, border-color .2s ease;
  }
  .fp-cria-strip:hover .fp-cria-cta {
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(59, 130, 246, 0.3);
  }

  @media (max-width: 576px) {
    .fp-cria-strip {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem 1.25rem;
    }
    .fp-cria-body {
      text-align: center;
    }
    .fp-cria-cta {
      width: 100%;
      justify-content: center;
    }
  }

  .fp-card-hover {
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    border: 1px solid var(--ct-border);
  }
  .fp-card-hover:hover {
    transform: translateY(-6px);
    border-color: rgba(59, 130, 246, 0.35);
    box-shadow: 0 20px 40px -20px rgba(37, 99, 235, 0.35);
  }

  .fp-stat-value {
    font-variant-numeric: tabular-nums;
  }

  .fp-btn-glow {
    position: relative;
    overflow: hidden;
  }
  .fp-btn-glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.25), transparent);
    transform: translateX(-120%);
    transition: transform .6s ease;
  }
  .fp-btn-glow:hover::after {
    transform: translateX(120%);
  }

  .fp-step-num {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--ct-blue-light);
    letter-spacing: 0.08em;
  }

  /* Ajustes de responsividade */
  @media (max-width: 576px) {
    .fp-stat-value {
      font-size: 1.15rem;
    }
    .stat-label {
      font-size: 0.75rem;
    }
    .card.fp-card-hover {
      padding: 1.25rem !important;
    }
  }
</style>

