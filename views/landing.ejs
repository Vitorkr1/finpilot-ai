<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Fade-in on scroll
    var fadeEls = document.querySelectorAll('[data-fp-fade]');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    fadeEls.forEach(function (el) { io.observe(el); });

    // Count-up numbers
    var counters = document.querySelectorAll('[data-count]');
    var counted = false;
    var countIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !counted) {
          counted = true;
          counters.forEach(function (el) {
            var target = parseInt(el.getAttribute('data-count'), 10);
            var prefix = el.getAttribute('data-prefix') || '';
            var suffixEl = el.querySelector('span');
            var duration = 1200;
            var start = null;

            function step(ts) {
              if (!start) start = ts;
              var progress = Math.min((ts - start) / duration, 1);
              var value = Math.floor(progress * target);
              el.childNodes[0].nodeValue = prefix + value.toLocaleString('pt-BR');
              if (suffixEl) el.appendChild(suffixEl);
              if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          });
          countIO.disconnect();
        }
      });
    }, { threshold: 0.4 });
    if (counters.length) countIO.observe(counters[0]);
  });
</script>
