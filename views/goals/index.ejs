<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <h2 class="display mb-0">Minhas Metas</h2>
        <p style="color:var(--text-muted);margin:0;">Defina objetivos e acompanhe seu progresso.</p>
      </div>
      <button class="btn-fp btn-primary-fp" onclick="openGoalModal()"><i class="fa-solid fa-plus"></i> Nova Meta</button>
    </div>

    <div class="row g-3" id="goalsGrid"></div>
    <div class="empty-state d-none" id="goalsEmpty">
      <i class="fa-solid fa-bullseye"></i>
      <p>Você ainda não tem metas. Que tal começar com uma reserva de emergência?</p>
      <button class="btn-fp btn-primary-fp" onclick="openGoalModal()">Criar primeira meta</button>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

<!-- Modal Meta -->
<div class="modal fade" id="goalModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:20px;border:none;">
      <div class="modal-body p-4">
        <h5 class="display mb-3">Nova Meta</h5>
        <form id="goalForm" class="form-fp">
          <div class="row g-3">
            <div class="col-12">
              <label>Título da Meta</label>
              <input type="text" class="form-control" name="title" required placeholder="Ex: Viagem para o Nordeste">
            </div>
            <div class="col-6">
              <label>Valor Alvo (R$)</label>
              <input type="number" step="0.01" min="1" class="form-control" name="targetAmount" required>
            </div>
            <div class="col-6">
              <label>Já economizado (R$)</label>
              <input type="number" step="0.01" min="0" class="form-control" name="currentAmount" value="0">
            </div>
            <div class="col-6">
              <label>Prazo</label>
              <input type="date" class="form-control" name="deadline">
            </div>
            <div class="col-6">
              <label>Contribuição mensal (R$)</label>
              <input type="number" step="0.01" min="0" class="form-control" name="monthlyContribution" value="0">
            </div>
          </div>
          <button type="submit" class="btn-fp btn-primary-fp w-100 py-2 mt-4" id="goalSubmitBtn">Salvar Meta</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/scripts') %>

<script>
  const availableBanks = <%- JSON.stringify(banks.map(b => ({ id: b._id, name: b.name }))) %>;
  const goalModal = new bootstrap.Modal(document.getElementById('goalModal'));
  function openGoalModal() {
    document.getElementById('goalForm').reset();
    goalModal.show();
  }

  document.getElementById('goalForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('goalSubmitBtn');
    const formData = new FormData(e.target);
    fpSetLoading(btn, true);
    try {
      await fpFetch('/api/goals', { method: 'POST', body: Object.fromEntries(formData) });
      fpToast('Meta criada com sucesso!');
      goalModal.hide();
      loadGoals();
    } catch (err) {
      fpToast(err.message, 'error');
    } finally {
      fpSetLoading(btn, false);
    }
  });

  async function loadGoals() {
    try {
      const data = await fpFetch('/api/goals');
      const grid = document.getElementById('goalsGrid');
      const empty = document.getElementById('goalsEmpty');

      if (data.goals.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('d-none');
        return;
      }
      empty.classList.add('d-none');

      grid.innerHTML = data.goals.map(g => {
        const progress = Math.min(100, Math.round((g.currentAmount / g.targetAmount) * 100));
        const eta = g.estimatedCompletion ? new Date(g.estimatedCompletion).toLocaleDateString('pt-BR') : 'Indefinida';
        const safeIcon = fpEscapeHtml(g.icon);
        const safeTitle = fpEscapeHtml(g.title);
        const banksOptions = availableBanks.map(b => `<option value="${b.id}">${fpEscapeHtml(b.name)}</option>`).join('');
        return `
        <div class="col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div class="d-flex align-items-center gap-2">
                <div style="width:42px;height:42px;border-radius:12px;background:rgba(37,99,235,0.12);display:flex;align-items:center;justify-content:center;">
                  <i class="${safeIcon}" style="color:var(--blue);"></i>
                </div>
                <strong>${safeTitle}</strong>
              </div>
              ${g.status === 'concluida' ? '<span class="pill pill-green">Concluída</span>' : ''}
            </div>
            <div class="progress-fp mb-2"><div class="progress-fp-bar" style="width:${progress}%;"></div></div>
            <div class="d-flex justify-content-between" style="font-size:0.8rem;color:var(--text-muted);">
              <span>${fpFormatCurrency(g.currentAmount)}</span>
              <span>${fpFormatCurrency(g.targetAmount)}</span>
            </div>
            <div style="font-size:0.75rem;color:var(--text-faint);margin-top:0.5rem;">
              <i class="fa-solid fa-calendar"></i> Previsão: ${eta}
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3 fp-contribute-row">
              <input type="number" placeholder="Valor" id="contrib-${g._id}" class="form-control" style="flex:1 1 90px;min-width:0;">
              <select id="contrib-bank-${g._id}" class="form-control" style="flex:1 1 120px;min-width:0;max-width:160px;">
                <option value="">Fora do app</option>
                ${banksOptions}
              </select>
              <button class="btn-fp btn-success-fp" onclick="contribute('${g._id}')" title="Aportar"><i class="fa-solid fa-plus"></i></button>
              <button class="btn-fp btn-danger-fp" onclick="deleteGoal('${g._id}')"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
        </div>`;
      }).join('');
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  async function contribute(id) {
    const input = document.getElementById('contrib-' + id);
    const bankSelect = document.getElementById('contrib-bank-' + id);
    const amount = parseFloat(input.value);
    if (!amount || amount <= 0) return fpToast('Informe um valor válido.', 'error');
    try {
      await fpFetch(`/api/goals/${id}/contribute`, { method: 'POST', body: { amount, bank: bankSelect.value || undefined } });
      fpToast(bankSelect.value ? 'Aporte realizado e descontado do banco!' : 'Contribuição adicionada!');
      loadGoals();
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  async function deleteGoal(id) {
    if (!confirm('Deseja realmente excluir esta meta?')) return;
    try {
      await fpFetch('/api/goals/' + id, { method: 'DELETE' });
      fpToast('Meta excluída.');
      loadGoals();
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  loadGoals();
</script>
