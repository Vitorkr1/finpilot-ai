<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <h2 class="display mb-0">Relatórios</h2>
        <p style="color:var(--text-muted);margin:0;">Compare seus meses e veja quais categorias estão pesando mais.</p>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-lg-12">
        <div class="card">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Receitas x Despesas — últimos 12 meses</h5>
          </div>
          <canvas id="monthlyChart" height="90"></canvas>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-lg-12">
        <div class="card">
          <h5 class="mb-3" id="yearlyTitle">Comparativo ano a ano</h5>
          <canvas id="yearlyChart" height="90"></canvas>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-lg-12">
        <div class="card">
          <h5 class="mb-3">Categorias em alta e em queda</h5>
          <p style="font-size:0.8rem;color:var(--text-muted);">Compara a primeira metade com a segunda metade do período — mostra pra onde seus gastos estão se movendo.</p>
          <div id="categoryComparisonList"></div>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>

<script>
  async function loadMonthlyChart() {
    try {
      const data = await fpFetch('/api/reports/monthly?months=12');
      new Chart(document.getElementById('monthlyChart'), {
        type: 'bar',
        data: {
          labels: data.labels,
          datasets: [
            { label: 'Receitas', data: data.income, backgroundColor: '#22C55E' },
            { label: 'Despesas', data: data.expense, backgroundColor: '#EF4444' }
          ]
        },
        options: { plugins: { legend: { position: 'bottom' } }, scales: { y: { beginAtZero: true } } }
      });
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  async function loadYearlyChart() {
    try {
      const data = await fpFetch('/api/reports/yearly');
      document.getElementById('yearlyTitle').textContent = `Despesas: ${data.currentYear} x ${data.previousYear}`;
      new Chart(document.getElementById('yearlyChart'), {
        type: 'line',
        data: {
          labels: data.labels,
          datasets: [
            { label: String(data.previousYear), data: data.previousYearData, borderColor: '#94A3B8', backgroundColor: 'rgba(148,163,184,0.1)', tension: 0.3, fill: true },
            { label: String(data.currentYear), data: data.currentYearData, borderColor: '#2563EB', backgroundColor: 'rgba(37,99,235,0.1)', tension: 0.3, fill: true }
          ]
        },
        options: { plugins: { legend: { position: 'bottom' } }, scales: { y: { beginAtZero: true } } }
      });
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  async function loadCategoryComparison() {
    const list = document.getElementById('categoryComparisonList');
    try {
      const data = await fpFetch('/api/reports/category-comparison?months=6');
      if (data.categories.length === 0) {
        list.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">Sem dados suficientes ainda.</p>';
        return;
      }
      list.innerHTML = data.categories.map((c) => {
        const up = c.change > 0;
        const color = up ? 'var(--danger)' : 'var(--green)';
        const icon = up ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down';
        return `
          <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom:1px solid var(--border);">
            <div class="d-flex align-items-center gap-2">
              <span style="width:10px;height:10px;border-radius:50%;background:${fpEscapeHtml(c.color)};display:inline-block;"></span>
              <strong style="font-size:0.88rem;">${fpEscapeHtml(c.name)}</strong>
            </div>
            <div class="d-flex align-items-center gap-3">
              <span style="font-size:0.85rem;color:var(--text-muted);">${fpFormatCurrency(c.secondHalf)}</span>
              <span style="font-size:0.8rem;font-weight:700;color:${color};"><i class="fa-solid ${icon}"></i> ${Math.abs(c.change)}%</span>
            </div>
          </div>`;
      }).join('');
    } catch (err) {
      list.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">Não foi possível carregar.</p>';
    }
  }

  loadMonthlyChart();
  loadYearlyChart();
  loadCategoryComparison();
</script>
