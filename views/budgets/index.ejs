<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <h2 class="display mb-0">Orçamentos</h2>
        <p style="color:var(--text-muted);margin:0;">Defina um limite mensal por categoria e acompanhe o quanto já gastou.</p>
      </div>
      <button class="btn-fp btn-primary-fp" onclick="openBudgetModal()"><i class="fa-solid fa-plus"></i> Novo Orçamento</button>
    </div>

    <div class="row g-3" id="budgetsGrid"></div>
    <div class="empty-state d-none" id="budgetsEmpty">
      <i class="fa-solid fa-wallet"></i>
      <p>Você ainda não definiu orçamentos. Comece limitando uma categoria que costuma pesar no mês.</p>
      <button class="btn-fp btn-primary-fp" onclick="openBudgetModal()">Criar primeiro orçamento</button>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

<!-- Modal Orçamento -->
<div class="modal fade" id="budgetModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:20px;border:none;">
      <div class="modal-body p-4">
        <h5 class="display mb-3">Novo Orçamento</h5>
        <form id="budgetForm" class="form-fp">
          <div class="row g-3">
            <div class="col-12">
              <label>Categoria</label>
              <select class="form-control" name="category" required>
                <% categories.forEach(c => { %><option value="<%= c._id %>"><%= c.name %></option><% }) %>
              </select>
            </div>
            <div class="col-12">
              <label>Limite mensal (R$)</label>
              <input type="number" step="0.01" min="0.01" class="form-control" name="monthlyLimit" required>
            </div>
          </div>
          <p style="font-size:0.78rem;color:var(--text-faint);margin-top:0.75rem;">Se a categoria já tiver um orçamento, o limite é atualizado.</p>
          <button type="submit" class="btn-fp btn-primary-fp w-100 py-2 mt-2" id="budgetSubmitBtn">Salvar Orçamento</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/scripts') %>

<script>
  const budgetModal = new bootstrap.Modal(document.getElementById('budgetModal'));
  function openBudgetModal() {
    document.getElementById('budgetForm').reset();
    budgetModal.show();
  }

  document.getElementById('budgetForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('budgetSubmitBtn');
    const formData = new FormData(e.target);
    fpSetLoading(btn, true);
    try {
      await fpFetch('/api/budgets', { method: 'POST', body: Object.fromEntries(formData) });
      fpToast('Orçamento salvo com sucesso!');
      budgetModal.hide();
      loadBudgets();
    } catch (err) {
      fpToast(err.message, 'error');
    } finally {
      fpSetLoading(btn, false);
    }
  });

  function statusColor(status) {
    if (status === 'estourado') return 'var(--danger)';
    if (status === 'atencao') return '#B45309';
    return 'var(--green)';
  }

  async function loadBudgets() {
    try {
      const data = await fpFetch('/api/budgets');
      const grid = document.getElementById('budgetsGrid');
      const empty = document.getElementById('budgetsEmpty');

      if (data.budgets.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('d-none');
        return;
      }
      empty.classList.add('d-none');

      grid.innerHTML = data.budgets.map(b => {
        const color = statusColor(b.status);
        const pct = Math.min(100, b.percent);
        const safeIcon = fpEscapeHtml((b.category.icon || 'fa-solid fa-tag').replace('fa-solid ', ''));
        const safeName = fpEscapeHtml(b.category.name);
        const warning = b.status === 'estourado'
          ? '<span class="pill" style="background:rgba(220,38,38,0.12);color:var(--danger);">Estourou o limite</span>'
          : b.status === 'atencao'
            ? '<span class="pill" style="background:#B4500912;color:#B45309;">Perto do limite</span>'
            : '';
        return `
        <div class="col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div class="d-flex align-items-center gap-2">
                <div style="width:42px;height:42px;border-radius:12px;background:${fpEscapeHtml(b.category.color)}22;display:flex;align-items:center;justify-content:center;">
                  <i class="fa-solid ${safeIcon}" style="color:${fpEscapeHtml(b.category.color)};"></i>
                </div>
                <strong>${safeName}</strong>
              </div>
              ${warning}
            </div>
            <div class="progress-fp mb-2"><div class="progress-fp-bar" style="width:${pct}%;background:${color};"></div></div>
            <div class="d-flex justify-content-between" style="font-size:0.8rem;color:var(--text-muted);">
              <span>${fpFormatCurrency(b.spent)} gastos</span>
              <span>limite ${fpFormatCurrency(b.monthlyLimit)}</span>
            </div>
            <div class="d-flex gap-2 mt-3">
              <input type="number" placeholder="Novo limite" id="limit-${b._id}" class="form-control" style="flex:1;">
              <button class="btn-fp btn-ghost-fp" onclick="updateLimit('${b._id}')" title="Atualizar limite"><i class="fa-solid fa-pen"></i></button>
              <button class="btn-fp btn-danger-fp" onclick="deleteBudget('${b._id}')"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
        </div>`;
      }).join('');
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  async function updateLimit(id) {
    const input = document.getElementById('limit-' + id);
    const value = parseFloat(input.value);
    if (!value || value <= 0) return fpToast('Informe um novo limite válido.', 'error');
    try {
      await fpFetch('/api/budgets/' + id, { method: 'PUT', body: { monthlyLimit: value } });
      fpToast('Limite atualizado.');
      loadBudgets();
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  async function deleteBudget(id) {
    if (!confirm('Deseja realmente remover este orçamento?')) return;
    try {
      await fpFetch('/api/budgets/' + id, { method: 'DELETE' });
      fpToast('Orçamento removido.');
      loadBudgets();
    } catch (err) {
      fpToast(err.message, 'error');
    }
  }

  loadBudgets();
</script>
