<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <h2 class="display mb-0">Consultor Financeiro IA</h2>
        <p style="color:var(--text-muted);margin:0;">Pergunte qualquer coisa sobre suas finanças.</p>
      </div>
    </div>

    <!-- Insights automáticos -->
    <div class="row g-3 mb-3" id="insightsGrid"></div>

    <!-- Perguntas rápidas -->
    <div class="d-flex flex-wrap gap-2 mb-3">
      <button class="btn-fp btn-ghost-fp quick-q">Onde gasto mais?</button>
      <button class="btn-fp btn-ghost-fp quick-q">Quanto consigo guardar este mês?</button>
      <button class="btn-fp btn-ghost-fp quick-q">Minha saúde financeira está boa?</button>
      <button class="btn-fp btn-ghost-fp quick-q">Como aumentar meu score?</button>
    </div>

    <!-- Chat -->
    <div class="card" style="min-height:400px;display:flex;flex-direction:column;">
      <div id="chatBox" style="flex:1;overflow-y:auto;max-height:50vh;margin-bottom:1rem;">
        <div class="d-flex gap-2 mb-3">
          <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--green));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fa-solid fa-wand-magic-sparkles" style="color:#fff;font-size:0.85rem;"></i>
          </div>
          <div class="card-flat" style="padding:0.8rem 1rem;max-width:80%;">
            Olá, <%= user.name.split(' ')[0] %>! Sou o consultor financeiro do FinPilot AI. Pergunte sobre seus gastos, economias, metas ou peça dicas personalizadas.
          </div>
        </div>
      </div>
      <form id="chatForm" class="d-flex gap-2">
        <input type="text" class="form-control" id="chatInput" placeholder="Ex: Estou gastando demais este mês?" required style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:12px;padding:0.65rem 0.9rem;">
        <button type="submit" class="btn-fp btn-primary-fp" id="chatSendBtn"><i class="fa-solid fa-paper-plane"></i></button>
      </form>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/scripts') %>

<script>
  const chatBox = document.getElementById('chatBox');

  function addMessage(text, from = 'ai') {
    // Mensagens do usuário sempre são escapadas aqui; mensagens da IA já chegam
    // escapadas de quem chamou addMessage (ver askAI), pois ali precisamos
    // primeiro converter \n em <br> depois de escapar.
    if (from === 'user') text = fpEscapeHtml(text);
    const wrapper = document.createElement('div');
    wrapper.className = 'd-flex gap-2 mb-3' + (from === 'user' ? ' flex-row-reverse' : '');
    wrapper.innerHTML = from === 'ai' ? `
      <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--green));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="fa-solid fa-wand-magic-sparkles" style="color:#fff;font-size:0.85rem;"></i>
      </div>
      <div class="card-flat" style="padding:0.8rem 1rem;max-width:80%;white-space:pre-wrap;">${text}</div>
    ` : `
      <div class="card-flat" style="padding:0.8rem 1rem;max-width:80%;background:var(--blue);color:#fff;white-space:pre-wrap;">${text}</div>
    `;
    chatBox.appendChild(wrapper);
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  async function askAI(question) {
    addMessage(question, 'user');
    document.getElementById('chatInput').value = '';
    const btn = document.getElementById('chatSendBtn');
    fpSetLoading(btn, true);
    try {
      const data = await fpFetch('/api/ai/ask', { method: 'POST', body: { question } });
      // Escapa a resposta da IA ANTES de converter quebras de linha em <br> —
      // a resposta vem de um modelo de linguagem e não pode ser tratada como HTML
      // confiável (poderia ser induzida a devolver tags/scripts).
      addMessage(fpEscapeHtml(data.answer).replace(/\n/g, '<br>'), 'ai');
    } catch (err) {
      addMessage(fpEscapeHtml('Desculpe, não consegui processar sua pergunta agora. ' + err.message), 'ai');
    } finally {
      fpSetLoading(btn, false);
      document.getElementById('chatSendBtn').innerHTML = '<i class="fa-solid fa-paper-plane"></i>';
    }
  }

  document.getElementById('chatForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const val = document.getElementById('chatInput').value.trim();
    if (val) askAI(val);
  });

  document.querySelectorAll('.quick-q').forEach(btn => {
    btn.addEventListener('click', () => askAI(btn.textContent));
  });

  async function loadInsights() {
    try {
      const data = await fpFetch('/api/ai/insights');
      const grid = document.getElementById('insightsGrid');
      if (!data.configured) {
        grid.innerHTML = `<div class="col-12"><div class="card" style="border-left:3px solid var(--warning);">
          <i class="fa-solid fa-triangle-exclamation" style="color:var(--warning);"></i>
          A IA ainda não foi configurada neste servidor (variável GROQ_API_KEY ausente).
        </div></div>`;
        return;
      }
      if (!data.insights || data.insights.length === 0) return;

      const icons = { alerta: 'fa-triangle-exclamation', oportunidade: 'fa-lightbulb', previsao: 'fa-chart-line' };
      const colors = { alerta: 'var(--danger)', oportunidade: 'var(--green)', previsao: 'var(--blue)' };

      grid.innerHTML = data.insights.map(i => `
        <div class="col-md-6 col-lg-4">
          <div class="card h-100">
            <i class="fa-solid ${icons[i.type] || 'fa-circle-info'}" style="color:${colors[i.type] || 'var(--blue)'};font-size:1.2rem;"></i>
            <h6 class="mt-2 mb-1">${fpEscapeHtml(i.title)}</h6>
            <p style="font-size:0.85rem;color:var(--text-muted);margin:0;">${fpEscapeHtml(i.message)}</p>
          </div>
        </div>
      `).join('');
    } catch {
      // silencioso
    }
  }

  loadInsights();
</script>
