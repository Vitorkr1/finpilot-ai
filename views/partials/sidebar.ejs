<aside class="sidebar">
  <div class="sidebar-brand">
    <img src="/img/logo.svg" alt="FinPilot AI">
    <span>FinPilot <span style="color:var(--green)">AI</span></span>
    <div class="dropdown" style="margin-left:auto;">
      <button class="btn-fp btn-ghost-fp" style="padding:0.4rem 0.6rem;position:relative;" data-bs-toggle="dropdown" id="notifBell" title="Notificações">
        <i class="fa-solid fa-bell"></i>
        <span id="notifBadge" class="d-none" style="position:absolute;top:-2px;right:-2px;background:var(--danger);color:#fff;font-size:0.62rem;font-weight:700;border-radius:50%;width:16px;height:16px;display:flex;align-items:center;justify-content:center;"></span>
      </button>
      <div class="dropdown-menu dropdown-menu-end" style="width:320px;max-height:400px;overflow-y:auto;" id="notifDropdown">
        <p style="padding:0.75rem 1rem;margin:0;color:var(--text-muted);font-size:0.85rem;">Carregando...</p>
      </div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= path === '/dashboard' ? 'active' : '' %>"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
    <a href="/banks" class="sidebar-link <%= path === '/banks' ? 'active' : '' %>"><i class="fa-solid fa-building-columns"></i> Meus Bancos</a>
    <a href="/transactions" class="sidebar-link <%= path === '/transactions' ? 'active' : '' %>"><i class="fa-solid fa-arrow-right-arrow-left"></i> Movimentações</a>
    <a href="/goals" class="sidebar-link <%= path === '/goals' ? 'active' : '' %>"><i class="fa-solid fa-bullseye"></i> Metas</a>
    <a href="/budgets" class="sidebar-link <%= path === '/budgets' ? 'active' : '' %>"><i class="fa-solid fa-wallet"></i> Orçamentos</a>
    <a href="/calendar" class="sidebar-link <%= path === '/calendar' ? 'active' : '' %>"><i class="fa-solid fa-calendar-days"></i> Calendário</a>
    <a href="/reports" class="sidebar-link <%= path === '/reports' ? 'active' : '' %>"><i class="fa-solid fa-chart-column"></i> Relatórios</a>
    <a href="/categories" class="sidebar-link <%= path === '/categories' ? 'active' : '' %>"><i class="fa-solid fa-tags"></i> Categorias</a>
    <a href="/ai" class="sidebar-link <%= path === '/ai' ? 'active' : '' %>"><i class="fa-solid fa-wand-magic-sparkles"></i> Consultor IA</a>
    <a href="/profile" class="sidebar-link <%= path === '/profile' ? 'active' : '' %>"><i class="fa-solid fa-user"></i> Perfil</a>
  </nav>

  <div class="card-flat" style="padding:1rem;">
    <div class="d-flex align-items-center gap-2 mb-2">
      <img src="<%= user.avatar %>" alt="" style="width:34px;height:34px;border-radius:50%;object-fit:cover;">
      <div style="min-width:0;">
        <div style="font-weight:700;font-size:0.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= user.name %></div>
        <div style="font-size:0.72rem;color:var(--text-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= user.email %></div>
      </div>
    </div>
    <button class="btn-fp btn-ghost-fp w-100" id="logoutBtn"><i class="fa-solid fa-right-from-bracket"></i> Sair</button>
  </div>
</aside>

<nav class="bottom-nav">
  <div class="bottom-nav-inner">
    <a href="/dashboard" class="bottom-nav-link <%= path === '/dashboard' ? 'active' : '' %>"><i class="fa-solid fa-chart-pie"></i>Início</a>
    <a href="/banks" class="bottom-nav-link <%= path === '/banks' ? 'active' : '' %>"><i class="fa-solid fa-building-columns"></i>Bancos</a>
    <a href="/goals" class="bottom-nav-link <%= path === '/goals' ? 'active' : '' %>"><i class="fa-solid fa-bullseye"></i>Metas</a>
    <a href="/ai" class="bottom-nav-link <%= path === '/ai' ? 'active' : '' %>"><i class="fa-solid fa-wand-magic-sparkles"></i>IA</a>
    <a href="/profile" class="bottom-nav-link <%= path === '/profile' ? 'active' : '' %>"><i class="fa-solid fa-user"></i>Perfil</a>
  </div>
</nav>

<button class="fab" onclick="window.location.href='/transactions?new=1'" title="Nova movimentação">
  <i class="fa-solid fa-plus"></i>
</button>
