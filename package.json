{
  "name": "criaos",
  "version": "0.1.0",
  "private": true,
  "description": "CriaOS — SaaS de gestão para empresas de instalação e manutenção (Cria Tech)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "admin": "npm run admin --workspace=server",
    "seed:super-admin": "npm run seed:super-admin --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
